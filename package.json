{
  "name": "yog",
  "private": true,
  "packageManager": "pnpm@10.33.0",
  "workspaces": [
    "apps/*"
  ],
  "devDependencies": {
    "@commitlint/cli": "^21.2.4",
    "@commitlint/config-conventional": "^21.2.4",
    "@commitlint/types": "^21.2.3",
    "@ianvs/prettier-plugin-sort-imports": "^4.7.1",
    "commitizen": "^4.3.2",
    "cz-conventional-changelog": "^3.3.0",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "prettier": "^3.9.10"
  },
  "scripts": {
    "dev": "pnpm --parallel --filter './apps/*' run dev",
    "dev:web": "pnpm --filter ./apps/web run dev",
    "dev:api": "pnpm --filter ./apps/api run dev",
    "prepare": "husky",
    "typecheck": "pnpm -r --if-present run typecheck",
    "lint": "pnpm -r --if-present run lint",
    "format": "prettier --write .",
    "format:check": "prettier --check .",
    "check": "pnpm typecheck && pnpm lint && pnpm format:check",
    "cz": "cz",
    "db:up": "docker compose up -d postgres",
    "db:stop": "docker compose stop postgres",
    "db:logs": "docker compose logs -f postgres",
    "db:shell": "docker compose exec postgres psql -U yog -d yog"
  },
  "lint-staged": {
    "*": "prettier --write --ignore-unknown"
  },
  "config": {
    "commitizen": {
      "path": "cz-conventional-changelog"
    }
  }
}
